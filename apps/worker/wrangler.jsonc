{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchtogether",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // The built React app is served from the same Worker; only /api and /ws run code.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "RATE_LIMIT", "class_name": "RateLimit" },
      { "name": "BROWSER_LEASE", "class_name": "BrowserLease" }
    ]
  },
  // SQLite-backed classes are the ones available on the Workers Free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "RateLimit"] },
    { "tag": "v2", "new_sqlite_classes": ["BrowserLease"] }
  ],
  "observability": { "enabled": true }
}
