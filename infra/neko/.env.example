# Copy to .env (setup.sh does this for you) and fill in.

# Hostname that points at this server, e.g. nayan-watch.duckdns.org
NEKO_DOMAIN=

# The server's public IPv4 address (Oracle console → Instance → Public IP)
PUBLIC_IP=

# Where the Watch Together site lives, e.g. https://watchtogether.you.workers.dev
# Until the site is deployed, leave the placeholder: nothing can embed the browser.
SITE_ORIGIN=https://not-set.invalid

# Admin token for neko's API. Keep it secret; generate with: openssl rand -hex 32
NEKO_API_TOKEN=
